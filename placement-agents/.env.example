# --- Telegram bot (create with @BotFather) ---
TELEGRAM_BOT_TOKEN=
# --- LLM (optional; plain templates are used if empty). Use OpenRouter OR Anthropic ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
ANTHROPIC_API_KEY=
# --- Voice chat: speech-to-text (free key at console.groq.com) ---
GROQ_API_KEY=
# voices: hi-IN-SwaraNeural / hi-IN-MadhurNeural, en-IN-NeerjaNeural / en-IN-PrabhatNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_EN=en-IN-NeerjaNeural
# --- Telegram "call" via a SECOND account (get api id/hash at my.telegram.org) ---
TG_API_ID=
TG_API_HASH=
# your MAIN account username (e.g. @yourname) or phone with country code
TG_CALL_TARGET=
# --- Phone app (ntfy). Pick a long random secret topic, subscribe to it in the ntfy app ---
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# --- LeetCode public username (auto-sync of solved problems) ---
LEETCODE_USERNAME=
# --- Voice page (live two-way talk). Auto tunnel needs cloudflared; or set a fixed https URL ---
WEB_PORT=8765
WEB_PUBLIC_URL=
# --- Where the bot runs ---
# local  = bot runs on your Windows PC and watches it directly
# remote = bot runs on a server; your PC runs pc_agent.py and sends heartbeats via ntfy
WATCHER_SOURCE=local
TZ_NAME=Asia/Kolkata
# --- Schedule ---
MORNING_TIME=07:30
DEFAULT_STUDY_TIME=19:00
